# Copy this file to `.env.release.local` and fill in local secrets.
# `.env.release.local` is ignored by git.

# Tauri updater signing.
# Prefer pointing to a local private-key file. The release script will read the file
# and pass its contents to Tauri through TAURI_SIGNING_PRIVATE_KEY.
TAURI_SIGNING_PRIVATE_KEY=path/to/nexuspilot.key
# Leave empty if the signing key was created without a password.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Local release archive and public updater/download URL base.
RELEASE_OUTPUT_DIR=releases
RELEASE_PUBLIC_BASE_URL=https://dl.nexuspilot.dev/releases

# MinIO / S3-compatible object storage.
RELEASE_S3_ENDPOINT=http://127.0.0.1:9000
RELEASE_S3_REGION=us-east-1
RELEASE_S3_BUCKET=nexuspilot
RELEASE_S3_PREFIX=releases
RELEASE_S3_ACCESS_KEY_ID=change-me
RELEASE_S3_SECRET_ACCESS_KEY=change-me
RELEASE_S3_FORCE_PATH_STYLE=true

# Current updater target. Keep NSIS as the updater artifact for Windows.
RELEASE_UPDATER_PLATFORM=windows-x86_64
RELEASE_UPDATER_ARTIFACT=nsis
