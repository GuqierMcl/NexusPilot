---
import { mainNavLinks } from "../shared/config/navigation";
import { repositoryBadges } from "../shared/config/repository";
import ShieldBadge from "./ShieldBadge.astro";
---

<header
  class="site-header fixed top-0 left-0 right-0 z-50"
>
  <nav class="relative mx-auto flex h-16 max-w-6xl items-center px-6">
    <a href="/" class="flex items-center gap-2.5 text-white">
      <img src="/NIEEX.svg" alt="NexusPilot" class="h-8 invert" />
      <!-- <img src="/wordmark.svg" alt="NexusPilot" class="h-5 w-auto invert" /> -->
    </a>

    <ul class="absolute left-1/2 hidden -translate-x-1/2 items-center gap-6 md:flex lg:gap-8">
      {mainNavLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm text-zinc-400 transition-colors hover:text-white"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="ml-auto flex shrink-0 items-center">
      <ShieldBadge
        badge={repositoryBadges.stars}
        loading="eager"
        class="rounded"
      />
    </div>
  </nav>
</header>
