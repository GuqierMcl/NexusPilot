---
import { footerLinks, publicSourceLinks } from "../shared/config/navigation";

const currentYear = new Date().getFullYear();
const links = [...footerLinks, ...publicSourceLinks];
---

<footer class="border-t border-white/[0.06] bg-[#09090b] py-10">
  <div class="mx-auto flex max-w-5xl flex-col gap-6 px-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-2">
      <img src="/logo.svg" alt="NexusPilot" class="h-5 w-5" />
      <img src="/wordmark.svg" alt="NexusPilot" class="h-3 w-auto invert opacity-50" />
      <span class="ml-1 text-xs text-zinc-600">© {currentYear}</span>
    </div>

    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      {links.map((link) => (
        <a href={link.href} class="text-xs text-zinc-500 hover:text-white">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</footer>
