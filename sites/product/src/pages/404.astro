---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../shared/config/site";

const title = "页面未找到 | NexusPilot";
const description = "NexusPilot 官网页面未找到。";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="min-h-[calc(100vh-8rem)] bg-[#09090b] pt-16">
    <section class="mx-auto flex min-h-[32rem] max-w-5xl flex-col justify-center px-6 py-24">
      <p class="mb-3 font-mono text-xs text-zinc-600">404</p>
      <h1 class="mb-4 text-3xl font-semibold tracking-tight text-white md:text-4xl">
        页面未找到
      </h1>
      <p class="max-w-xl text-sm leading-relaxed text-zinc-500 md:text-base">
        这个地址暂时没有可访问的页面。你可以返回官网首页，或进入文档站查看当前公开内容。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/"
          class="inline-flex h-10 items-center rounded-lg px-5 text-sm font-medium text-white shadow-lg shadow-indigo-500/20 transition-all hover:shadow-indigo-500/30"
          style="background: var(--brand-gradient)"
        >
          返回首页
        </a>
        <a
          href={site.docsUrl}
          class="inline-flex h-10 items-center rounded-lg border border-white/[0.08] bg-white/[0.03] px-5 text-sm font-medium text-zinc-400 transition-all hover:bg-white/[0.06] hover:text-white"
        >
          查看文档
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
