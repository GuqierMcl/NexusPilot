---
import Footer from "../main-site/components/Footer.astro";
import Header from "../main-site/components/Header.astro";
import BaseLayout from "../main-site/layouts/BaseLayout.astro";
import { ReleaseHistory } from "../shared/components/ReleaseHistory";
---

<BaseLayout title="NexusPilot 发布日志" description="查看 NexusPilot 最新版本、历史更新日志和可用下载链接。">
  <Header />
  <main class="bg-[#09090b] py-20 text-white">
    <section class="mx-auto max-w-5xl px-6">
      <p class="mb-2 font-mono text-xs text-zinc-600">RELEASES</p>
      <h1 class="text-3xl font-semibold">发布日志</h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-zinc-400">
        查看 NexusPilot 的最新版本、历史更新内容和可用安装包。升级前可以在这里了解主要变化，并选择适合当前系统的下载项。
      </p>

      <div class="mt-10">
        <ReleaseHistory mode="website" client:load />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
