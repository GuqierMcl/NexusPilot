---
import { plannedDatabases, supportedDatabases } from "../../shared/config/product";
import DatabaseBrandIcon from "./DatabaseBrandIcon.astro";
---

<section id="databases" class="section-band section-band-databases">
  <div class="relative mx-auto max-w-5xl px-6">
    <div class="mb-12">
      <p class="section-kicker">DATABASES</p>
      <h2 class="section-title">数据库支持矩阵</h2>
    </div>

    <div class="database-group mb-10">
      <div class="mb-4 flex items-center gap-2">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        </span>
        <span class="font-mono text-xs text-emerald-400">已支持</span>
      </div>
      <div class="database-grid">
        {supportedDatabases.map((database) => (
          <article class="database-pill database-pill-active">
            <DatabaseBrandIcon iconKey={database.iconKey} />
            <div class="min-w-0 leading-tight">
              <h3 class="truncate text-sm font-medium text-emerald-200">{database.name}</h3>
              <p class="mt-1 font-mono text-[10px] text-emerald-400/55">
                {database.type}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="database-group">
      <div class="mb-4 flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-zinc-700"></span>
        <span class="font-mono text-xs text-zinc-600">规划中</span>
      </div>
      <div class="database-grid">
        {plannedDatabases.map((database) => (
          <article class="database-pill database-pill-planned">
            <DatabaseBrandIcon iconKey={database.iconKey} />
            <div class="min-w-0 leading-tight">
              <h3 class="truncate text-sm font-medium text-zinc-400">{database.name}</h3>
              <p class="mt-1 font-mono text-[10px] text-zinc-600">
                {database.type}
              </p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
