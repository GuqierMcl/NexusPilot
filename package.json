{
  "name": "nexuspilot",
  "description": "AI-powered cross-platform database management workbench",
  "private": true,
  "version": "0.10.2",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuqierMcl/NexusPilot.git"
  },
  "homepage": "https://nexuspilot.dev",
  "bugs": {
    "url": "https://github.com/GuqierMcl/NexusPilot/issues"
  },
  "keywords": [
    "database",
    "database-client",
    "database-workbench",
    "desktop",
    "tauri",
    "react",
    "ai",
    "sql",
    "redis",
    "clickhouse"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "ai-runtime"
  ],
  "trustedDependencies": [
    "esbuild",
    "msw"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "ai-runtime:dev": "bun --cwd=ai-runtime run dev -- --host 0.0.0.0 --port 8787",
    "ai-runtime:start": "bun --cwd=ai-runtime run start",
    "ai-runtime:test": "bun --cwd=ai-runtime test",
    "ai-runtime:typecheck": "bun --cwd=ai-runtime run typecheck",
    "ai-runtime:build": "bun scripts/build-ai-runtime.js",
    "preview": "vite preview",
    "site:product:dev": "bun --cwd=sites/product run dev",
    "site:product:build": "bun --cwd=sites/product run build",
    "site:product:preview": "bun --cwd=sites/product run preview",
    "site:docs:dev": "bun --cwd=sites/docs run dev",
    "site:docs:build": "bun --cwd=sites/docs run build",
    "site:docs:preview": "bun --cwd=sites/docs run preview",
    "sites:build": "bun run site:product:build && bun run site:docs:build",
    "tauri": "tauri",
    "dev:all": "concurrently -c \"cyan,magenta,yellow\" -n \"TAURI,AI_RUNTIME\" \"bun run tauri dev\" \"bun run ai-runtime:dev\"",
    "count-lines": "bun scripts/count_lines.js",
    "sync-version": "bun scripts/sync-version.js",
    "version:bump": "bun scripts/bump-version.js",
    "lock:refresh": "bun install --lockfile-only",
    "release": "bun scripts/release.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.40",
    "@assistant-ui/react": "^0.14.28",
    "@assistant-ui/react-ai-sdk": "^1.4.0",
    "@assistant-ui/react-markdown": "^0.14.7",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "~2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "~2",
    "@tauri-apps/plugin-http": "~2",
    "@tauri-apps/plugin-log": "~2.9.0",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "~2.4.2",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "@tauri-apps/plugin-window-state": "~2.4.1",
    "@xyflow/react": "^12.10.2",
    "ai": "^7.0.37",
    "ansi-to-react": "^6.2.6",
    "assistant-cloud": "^0.1.36",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "lodash-es": "^4.17.23",
    "lucide-react": "^1.18.0",
    "media-chrome": "^4.18.3",
    "motion": "^12.38.0",
    "nanoid": "^5.1.7",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.1.0",
    "react-jsx-parser": "^2.4.1",
    "react-resizable-panels": "^4.7.3",
    "react-router": "^7.13.1",
    "react-shiki": "^0.10.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "use-stick-to-bottom": "^1.1.3",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1078.0",
    "@tauri-apps/cli": "^2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.1",
    "shadcn": "^4.1.2",
    "typescript": "^6.0.3",
    "vite": "^7.0.4",
    "vite-plugin-svgr": "^5.0.0"
  }
}
