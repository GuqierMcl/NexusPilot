# NexusPilot 真实数据库集成测试配置。
#
# 将此文件复制为 `.env.test`，并填写本地凭据。
# `.env.test` 已刻意加入 git 忽略列表。不要提交真实密钥。
#
# 测试策略：
# - 缺失或未启用的驱动应由集成测试跳过。
# - 当驱动已启用时，可以运行只读冒烟测试。
# - 破坏性/写入测试只有在 NEXPILOT_TEST_ALLOW_WRITES=true 时才可运行。
# - 这些测试优先使用专用的、可丢弃的数据库/Schema/用户。

NEXPILOT_TEST_ALLOW_WRITES=false
NEXPILOT_TEST_CONNECT_TIMEOUT_SECONDS=10

# SQLite（本地文件）
NEXPILOT_TEST_SQLITE_ENABLED=false

# 请填写一个真实的本地 SQLite 文件路径。Windows 路径建议使用正斜杠，避免反斜杠转义歧义。
# 示例：D:/data/nexpilot-sqlite-smoke.sqlite3
NEXPILOT_TEST_SQLITE_DB_FILE_PATH=

# 默认只读打开。若要运行写入/编辑测试，请同时设置：
# - NEXPILOT_TEST_ALLOW_WRITES=true
# - NEXPILOT_TEST_SQLITE_READ_ONLY=false
# 并确保 DB_FILE_PATH 指向可丢弃文件或专用测试副本。
NEXPILOT_TEST_SQLITE_READ_ONLY=true

# 只读冒烟测试可选使用的现有对象。
NEXPILOT_TEST_SQLITE_READ_TABLE=
NEXPILOT_TEST_SQLITE_PK_TABLE=

# 写入测试使用的临时对象前缀。请保持为可丢弃数据。
NEXPILOT_TEST_SQLITE_SCRATCH_PREFIX=nexpilot_it_

# PostgreSQL
NEXPILOT_TEST_POSTGRES_ENABLED=false
NEXPILOT_TEST_POSTGRES_HOST=127.0.0.1
NEXPILOT_TEST_POSTGRES_PORT=5432
NEXPILOT_TEST_POSTGRES_USERNAME=nexpilot_test
NEXPILOT_TEST_POSTGRES_PASSWORD=
NEXPILOT_TEST_POSTGRES_DATABASE=nexpilot_test
NEXPILOT_TEST_POSTGRES_SCHEMA=public
NEXPILOT_TEST_POSTGRES_SSL_MODE=disable

# 只读冒烟测试可选使用的现有对象。
NEXPILOT_TEST_POSTGRES_READ_TABLE=
NEXPILOT_TEST_POSTGRES_PK_TABLE=

# MySQL
NEXPILOT_TEST_MYSQL_ENABLED=false
NEXPILOT_TEST_MYSQL_HOST=127.0.0.1
NEXPILOT_TEST_MYSQL_PORT=3306
NEXPILOT_TEST_MYSQL_USERNAME=nexpilot_test
NEXPILOT_TEST_MYSQL_PASSWORD=
NEXPILOT_TEST_MYSQL_DATABASE=nexpilot_test
NEXPILOT_TEST_MYSQL_SSL_MODE=disable

# 只读冒烟测试可选使用的现有对象。
NEXPILOT_TEST_MYSQL_READ_TABLE=
NEXPILOT_TEST_MYSQL_PK_TABLE=

# ClickHouse（Phase 0 凭据契约 / Phase 1 真实连接冒烟）
#
# 这些变量驱动 Phase 1 的 test_connection_config、shared runtime、tab runtime、
# ping、健康快照与断开清理真实冒烟测试。后续阶段会继续复用可选的只读对象
# 与 scratch 配置。NEXPILOT_TEST_CLICKHOUSE_ENABLED=false 不会发起真实连接。
NEXPILOT_TEST_CLICKHOUSE_ENABLED=false

# 本地 self-hosted HTTP 通常使用 8123。
# ClickHouse Cloud / HTTPS 常见端口为 8443，请同时把 PROTOCOL 改为 https。
NEXPILOT_TEST_CLICKHOUSE_PROTOCOL=http
NEXPILOT_TEST_CLICKHOUSE_HOST=127.0.0.1
NEXPILOT_TEST_CLICKHOUSE_PORT=8123
NEXPILOT_TEST_CLICKHOUSE_USERNAME=default
NEXPILOT_TEST_CLICKHOUSE_PASSWORD=
NEXPILOT_TEST_CLICKHOUSE_DATABASE=default

# 只读冒烟测试可选使用的现有对象。
NEXPILOT_TEST_CLICKHOUSE_READ_TABLE=
NEXPILOT_TEST_CLICKHOUSE_MATERIALIZED_VIEW=

# 写入、DDL 和 mutation 测试的临时对象前缀。
# 只有 NEXPILOT_TEST_CLICKHOUSE_ENABLED=true 且
# NEXPILOT_TEST_ALLOW_WRITES=true 时才允许创建或修改这些对象。
NEXPILOT_TEST_CLICKHOUSE_SCRATCH_PREFIX=nexpilot_it_

# 环境依赖的可选 Phase 2 真实证据；留空时测试打印明确 skip reason。
NEXPILOT_TEST_CLICKHOUSE_CLUSTER=
NEXPILOT_TEST_CLICKHOUSE_DICTIONARY=
NEXPILOT_TEST_CLICKHOUSE_LOW_PRIVILEGE_USERNAME=
NEXPILOT_TEST_CLICKHOUSE_LOW_PRIVILEGE_PASSWORD=

# Redis
NEXPILOT_TEST_REDIS_ENABLED=false
NEXPILOT_TEST_REDIS_HOST=127.0.0.1
NEXPILOT_TEST_REDIS_PORT=6379
NEXPILOT_TEST_REDIS_USERNAME=
NEXPILOT_TEST_REDIS_PASSWORD=
NEXPILOT_TEST_REDIS_DB_INDEX=0
NEXPILOT_TEST_REDIS_USE_TLS=false

# 写入测试使用的键前缀。请保持为可丢弃数据。
NEXPILOT_TEST_REDIS_KEY_PREFIX=nexpilot:it:

# Oracle
NEXPILOT_TEST_ORACLE_ENABLED=false
NEXPILOT_TEST_ORACLE_HOST=127.0.0.1
NEXPILOT_TEST_ORACLE_PORT=1521
NEXPILOT_TEST_ORACLE_USERNAME=nexus
NEXPILOT_TEST_ORACLE_PASSWORD=

# SERVICE_NAME、SID、CONNECT_DESCRIPTOR 三者只能使用其一。
NEXPILOT_TEST_ORACLE_SERVICE_NAME=FREEPDB1
NEXPILOT_TEST_ORACLE_SID=
NEXPILOT_TEST_ORACLE_CONNECT_DESCRIPTOR=
NEXPILOT_TEST_ORACLE_ROLE=normal
NEXPILOT_TEST_ORACLE_SCHEMA=NEXUS

# 只读冒烟测试可选使用的现有对象。
NEXPILOT_TEST_ORACLE_READ_TABLE=
NEXPILOT_TEST_ORACLE_PK_TABLE=

# 破坏性/写入集成测试的临时对象前缀。
# 测试用户/Schema 应具备创建和删除这些对象的权限。
# Oracle 写入 smoke 会在目标 schema 下创建并删除该前缀开头的 scratch 表。
NEXPILOT_TEST_SCRATCH_PREFIX=NEXPILOT_IT_
