{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexusPilot",
  "version": "0.10.2",
  "identifier": "NexusPilot",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run ai-runtime:build && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexusPilot",
        "label": "main",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "nsis",
      "dmg"
    ],
    "externalBin": [
      "binaries/ai-runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "NIEEX"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "dev.nexuspilot"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGMUE2Nzk5QThBNEQ1MkYKUldRdjFhU29tV2NhTHlMeXFYdXNOSll6eS8wcGx3aDZTbW5teFdRc1RNSDFFTWZ0MzBJZm1vc00K",
      "endpoints": [
        "https://dl.nexuspilot.dev/releases/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
